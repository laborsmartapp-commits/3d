{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "object",
        "animation",
        "audio",
        "texture"
      ]
    },
    "subcategory": {
      "type": "string",
      "description": "e.g. variant, costume, furniture, vehicle, dance, song, sfx"
    },
    "folder": {
      "type": "string",
      "default": ""
    },
    "file_uri": {
      "type": "string",
      "description": "Private file uri"
    },
    "file_name": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "thumbnail_uri": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "root_id": {
      "type": "string",
      "description": "Id of version 1; versions never overwrite each other"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "import_status": {
      "type": "string",
      "enum": [
        "ok",
        "failed"
      ],
      "default": "ok"
    },
    "import_error": {
      "type": "string"
    },
    "rig": {
      "type": "string",
      "description": "Rig/skeleton compatibility label"
    },
    "duration": {
      "type": "number"
    },
    "clip_name": {
      "type": "string",
      "description": "Animation clip inside the file (for clips extracted from a character)"
    },
    "source_asset_id": {
      "type": "string",
      "description": "Character asset this clip was extracted from"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "category",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "animator"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "animator"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "animator"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}