{
  "name": "RenderJob",
  "type": "object",
  "properties": {
    "take_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "1080p",
        "1440p",
        "4k"
      ]
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "fps": {
      "type": "number"
    },
    "preset": {
      "type": "string",
      "enum": [
        "standard",
        "high",
        "ultra",
        "maximum"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "rendering",
        "encoding",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "status_message": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "0-100"
    },
    "runpod_job_id": {
      "type": "string"
    },
    "runpod_status": {
      "type": "string"
    },
    "manifest": {
      "type": "object"
    },
    "frame_count": {
      "type": "number"
    },
    "render_token_hash": {
      "type": "string",
      "description": "SHA-256 of the per-job worker token (token itself is never stored)"
    },
    "worker_run_id": {
      "type": "string",
      "description": "RunPod job id that claimed this render (duplicate-execution guard)"
    },
    "claimed_at": {
      "type": "string"
    },
    "video_uri": {
      "type": "string",
      "description": "s3://bucket/key in the render storage bucket"
    },
    "video_width": {
      "type": "number",
      "description": "Measured by the worker from the encoded file"
    },
    "video_height": {
      "type": "number"
    },
    "video_fps": {
      "type": "number"
    },
    "video_duration": {
      "type": "number"
    },
    "file_size": {
      "type": "number"
    },
    "gpu": {
      "type": "string",
      "description": "WebGL renderer string reported by the worker"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "take_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}