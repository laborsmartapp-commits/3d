{
  "name": "Shot",
  "type": "object",
  "properties": {
    "production_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string",
      "description": "StudioScene id"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "camera_id": {
      "type": "string",
      "description": "Production camera id inside the scene"
    },
    "start_t": {
      "type": "number",
      "default": 0
    },
    "end_t": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "take_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied from the production so collaborators can edit shots"
    }
  },
  "required": [
    "production_id",
    "scene_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborators": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "animator"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.collaborators": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborators": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}