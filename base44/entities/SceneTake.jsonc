{
  "name": "SceneTake",
  "type": "object",
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "scene_name": {
      "type": "string"
    },
    "take_number": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "world": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "island_id": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "camera_name": {
      "type": "string"
    },
    "camera_mode": {
      "type": "string",
      "enum": [
        "static",
        "follow"
      ]
    },
    "camera_snapshot": {
      "type": "object"
    },
    "env_start": {
      "type": "object"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration": {
      "type": "number",
      "default": 0
    },
    "sample_count": {
      "type": "number",
      "default": 0
    },
    "chunk_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "capturing",
        "uploading",
        "captured"
      ],
      "default": "capturing"
    },
    "render_settings": {
      "type": "object"
    },
    "local_quality": {
      "type": "string"
    },
    "source_take_id": {
      "type": "string",
      "description": "Duplicates reuse the performance chunks of this take"
    },
    "thumb_uri": {
      "type": "string"
    }
  },
  "required": [
    "scene_id"
  ]
}