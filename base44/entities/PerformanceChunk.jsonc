{
  "name": "PerformanceChunk",
  "type": "object",
  "properties": {
    "take_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string",
      "description": "User id of the take owner, set by the secure upload function"
    },
    "index": {
      "type": "number"
    },
    "start_t": {
      "type": "number"
    },
    "end_t": {
      "type": "number"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Timestamped samples: {t, a:{actorId:{p,y,m,ph,sp,at,sit,sw}}, c:[x,y,z,qx,qy,qz,qw,fov], e:{h,w}}"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chunk_key": {
      "type": "string",
      "description": "Stable id `${take_id}:${index}` for idempotent upserts"
    }
  },
  "required": [
    "take_id",
    "index"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}